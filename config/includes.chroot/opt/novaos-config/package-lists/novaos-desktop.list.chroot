# NovaOS — Desktop & Installer packages (Person 2 owns this file)
# All lines here must be a bare package name, a blank line, or a line
# starting with '#'. NO inline comments — live-build passes the full
# line to apt-get, so "pkg # comment" would break the install pass.

# --- Desktop Environment (LXQt) ---
xorg
xserver-xorg
lxqt
lxqt-session
lxqt-panel
lxqt-config
lxqt-globalkeyshcuts
lxqt-qtplugin
lxqt-sudo
lxqt-themes
lxqt-policykit
lxqt-powermanagement
lxqt-notificationd
pcmanfm-qt
qterminal
qtermwidget
obconf-qt
openbox
lightdm
lightdm-gtk-greeter

# --- Theming / Fonts ---
qt5ct
adwaita-qt
adwaita-qt5
fonts-noto-core
fonts-noto-cjk
fonts-dejavu-core
# fonts-inter: NovaOS font; auto-fallback if missing
fonts-inter
# fonts-jetbrains-mono: for code editor / welcome app
fonts-jetbrains-mono
papirus-icon-theme
adwaita-icon-theme

# --- Display / Login ---
accountsservice
gnome-keyring
polkitd
pkexec
lightdm-gtk-greeter-settings

# --- Plymouth (boot splash) ---
plymouth
plymouth-themes
libplymouth5

# --- Calamares (installer) ---
calamares
calamares-settings-debian

# --- Welcome app runtime ---
python3-pyqt5
python3-pyqt5.qtsvg
xdg-utils

# --- Optional but recommended: lightweight office & docs ---
# zeal: offline dev docs
zeal
# libreoffice-core: keep it small; full LO is ~400MB
libreoffice-core
libreoffice-writer
libreoffice-calc
